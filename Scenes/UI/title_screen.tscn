[sub_resource type="Shader" id="Shader_logo"]
code = "shader_type canvas_item;

// La vidéo n'a pas de transparence : son fond est peint de la couleur de
// l'écran titre. On le rend transparent pour qu'aucun bord de cadre ne se
// devine, même si l'encodage décale légèrement la teinte.
uniform vec3 key_color : source_color = vec3(0.078431375, 0.043137256, 0.047058824);
uniform float threshold = 0.03;
uniform float softness = 0.05;

void fragment() {
	vec4 c = texture(TEXTURE, UV);
	float d = distance(c.rgb, key_color);
	COLOR = vec4(c.rgb, c.a * smoothstep(threshold, threshold + softness, d));
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_logo"]
shader = SubResource("Shader_logo")

